# Miruo Production & Development Environment Configuration
# Kopyalayıp .env dosyası oluşturun: cp .env.example .env

# Sunucu Portu
PORT=3000

# Çalışma Modu (development | production)
NODE_ENV=production

# Güvenli Oturum & Token Gizli Anahtarı (En az 32 karakterlik karmaşık anahtar)
SESSION_SECRET=miruo_prod_super_secret_session_key_2026_x89q2m_secure

# Webhook Doğrulama Gizli Anahtarı (HMAC SHA-256)
WEBHOOK_SECRET=miruo_webhook_hmac_secret_key_2026_prod

# Yönetici API Anahtarı (Admin işlemleri ve metrikler için)
ADMIN_API_KEY=miruo_admin_master_access_key_2026

# İzin Verilen CORS Alan Adları (Virgülle ayrılmış)
ALLOWED_ORIGINS=https://miruo.com.tr,https://www.miruo.com.tr,https://miruo.vercel.app,http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost

# Giriş Denemesi Sınırı (Rate Limiting)
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
