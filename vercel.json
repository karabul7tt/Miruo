{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "website",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self), autoplay=(self)" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/download/mac", "destination": "/downloads/Miruo.dmg" },
    { "source": "/download/mac-intel", "destination": "/downloads/Miruo-Intel.zip" },
    { "source": "/download/windows", "destination": "/downloads/Miruo-Windows.zip" },
    { "source": "/download/android", "destination": "/downloads/Miruo.apk" }
  ],
  "redirects": [
    { "source": "/app", "destination": "/app/", "permanent": false },
    { "source": "/oda/:code", "destination": "/app/?room=:code", "permanent": false },
    { "source": "/download/ios", "destination": "https://apps.apple.com/app/miruo/id6738928411", "permanent": false },
    { "source": "/privacy", "destination": "/gizlilik", "permanent": false },
    { "source": "/terms", "destination": "/sartlar", "permanent": false },
    { "source": "/support", "destination": "/iletisim", "permanent": false }
  ]
}
